# Sindarin environment configuration.
# Copy this file to `.env` and fill in only the keys you need.
#   cp .env.example .env
#
# Sindarin reads documented SINDARIN_* vars; legacy SCOUT_* aliases are still
# accepted for backwards compatibility (SINDARIN_* takes precedence).

# ---------------------------------------------------------------------------
# LinkedIn (optional). LinkedIn requires a logged-in session to view profiles.
# Obtain the `li_at` cookie ONLY in compliance with LinkedIn's Terms of Service
# and applicable law. With tools like browser dev tools: Application > Cookies >
# linkedin.com > li_at > copy value.
# ---------------------------------------------------------------------------
# LINKEDIN_COOKIE=your_li_at_cookie_value

# ---------------------------------------------------------------------------
# Twitch (optional). A Client ID enables the official Helix API which is more
# reliable. Register at https://dev.twitch.tv/console. Falls back to a best-
# effort public scrape if not set.
# ---------------------------------------------------------------------------
# TWITCH_CLIENT_ID=your_twitch_client_id

# ---------------------------------------------------------------------------
# GitHub (optional). A PAT raises the unauthenticated rate limit from 60/hr
# to 5000/hr.
# ---------------------------------------------------------------------------
# GITHUB_TOKEN=github_pat_...

# ---------------------------------------------------------------------------
# Enrichment (optional). Provide a Hunter.io key to add candidate emails via
# their public API. Still SMTP-free: Sindarin never probes mail servers.
# ---------------------------------------------------------------------------
# HUNTER_API_KEY=your_hunter_io_key

# ---------------------------------------------------------------------------
# Proxy support (optional). Pick one form.
# ---------------------------------------------------------------------------
# SINDARIN_PROXY=http://user:pass@host:port
# SINDARIN_PROXY_FILE=proxies.txt   # one proxy URL per line, rotated
# SINDARIN_FREE_PROXY=true          # use free proxies (unreliable)

# ---------------------------------------------------------------------------
# Rate limiting. Default: 2.0 seconds between requests per host. Raise it for
# politeness toward the target; lower it only if you have explicit permission.
# ---------------------------------------------------------------------------
# SINDARIN_DELAY=2.0
# SINDARIN_TIMEOUT=20

# ---------------------------------------------------------------------------
# robots.txt. Default: false. Set to true to refuse URLs disallowed by the
# target's robots.txt (honored only when enabled).
# ---------------------------------------------------------------------------
# SINDARIN_HONOR_ROBOTS=false

# ---------------------------------------------------------------------------
# User-agent override (optional). Sindarin uses a self-identifying UA by
# default so site operators can see who is calling.
# ---------------------------------------------------------------------------
# SINDARIN_USER_AGENT=Sindarin/0.2 (+https://github.com/samdoom-coder/Sindarin) public-profile-scraper
